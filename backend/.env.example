# Transport Finder reads its settings from the PROJECT-ROOT .env (one folder up), whichever folder
# the server is started from. See ../.env.example for every variable (APP_ENV, CORS_ORIGINS, DB_*, ...).
#
# Only for the optional, unused-by-default "db" data source (DATA_SOURCE=db):
# DATABASE_URL=mysql+pymysql://user:password@host:3306/transport_finder
