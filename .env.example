# Transport Finder - environment settings.
# Copy to ".env" in this folder (the project root) and fill in the values. Never commit the real .env.
# Real environment variables override anything in this file.

# --- Required -----------------------------------------------------------------------------------

# "production" disables the public API docs (/docs, /redoc, /openapi.json). Use "development" locally.
APP_ENV=production

# The address(es) the frontend is served from, comma-separated, exactly as the browser shows them
# (scheme + host + optional port, no trailing slash). Only needed when the frontend and API are on
# different origins; harmless otherwise.
CORS_ORIGINS=https://transport-finder.example.com

# Vacalvers MySQL RDS - a READ-ONLY account (grants: SELECT, SHOW VIEW only). Read at connection time
# only; never logged or sent to the browser.
DB_HOST=your-rds-host.rds.amazonaws.com
DB_PORT=3306
DB_USER=your_readonly_user
DB_PASSWORD=change-me
DB_NAME=your_database

# --- Optional (defaults shown) ------------------------------------------------------------------

# Admin data: accounts, users, sessions, preferences, Admin edits, uploaded images, shipment charges.
# MUST be on persistent storage and backed up. Default: data/transporter_overrides.db in this folder.
# OVERRIDES_DB_PATH=/srv/transport-finder/data/transporter_overrides.db

# Verified official company logos (manifest.json + image files). Default: data/transporter_logos
# TRANSPORTER_LOGOS_DIR=/srv/transport-finder/data/transporter_logos

# Where search data comes from: "rds" (default; falls back to the CSV below if RDS is unreachable).
# DATA_SOURCE=rds
# How long (seconds) to reuse the RDS snapshot before re-querying. Default: 1800 (30 minutes).
# RDS_CACHE_TTL_SECONDS=1800

# Fallback/lookup files. Defaults point one folder ABOVE this project; set these if they live elsewhere.
# VACALVERS_CSV_PATH=/srv/transport-finder/source/L135 Orders 01.09.26 to 30.09.26.csv
# BRANCHES_CSV=/srv/transport-finder/source/Branches_LIST_20260926.csv

# Where the RDS credentials above are read from. Default: this project's .env
# RDS_ENV_PATH=/srv/transport-finder/.env
